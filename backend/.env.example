# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Swiggy OAuth
SWIGGY_CLIENT_ID=your_swiggy_client_id
SWIGGY_REDIRECT_URI=http://localhost:8000/api/swiggy/callback

# Optional frontend redirect target used by the backend
SWIGGY_FRONTEND_URL=http://localhost:5173/

# Optional Gnani speech services (disabled by default)
# Keep this key server-side; never use a VITE_ prefixed variable.
GNANI_API_KEY=
GNANI_STT_ENABLED=false
GNANI_TTS_ENABLED=false
