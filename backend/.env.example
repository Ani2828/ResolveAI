# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Swiggy OAuth
SWIGGY_CLIENT_ID=your_swiggy_client_id
SWIGGY_REDIRECT_URI=http://localhost:8000/api/swiggy/callback

# Optional frontend redirect target used by the backend
SWIGGY_FRONTEND_URL=http://localhost:5173/

# Comma-separated browser origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://resolveai-frontend-9f0z.onrender.com

# Supabase Auth JWT verification and encrypted per-user Swiggy session storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SWIGGY_TOKEN_ENCRYPTION_KEY=your_fernet_key

# Optional Gnani speech services (disabled by default)
# Keep this key server-side; never use a VITE_ prefixed variable.
GNANI_API_KEY=
GNANI_STT_ENABLED=false
GNANI_TTS_ENABLED=false
